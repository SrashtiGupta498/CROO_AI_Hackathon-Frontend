# ── CAP connection ───────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values from the CROO Dashboard.
# (You register the Aura "skin-analysis" service in the Dashboard — that is what
#  issues the SDK-Key and the Service ID below. Registration is NOT done in code.)

CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws

# Your agent's SDK-Key from the Dashboard. Format: croo_sk_...
CROO_SDK_KEY=croo_sk_REPLACE_ME

# Optional. Custom Base JSON-RPC used for wallet balance checks.
# Defaults to https://mainnet.base.org inside the SDK if omitted.
BASE_RPC_URL=https://mainnet.base.org

# ── Analysis worker ──────────────────────────────────────────────────────────
# Python interpreter that can import the mesh in ../cap-mesh.
PYTHON_BIN=python

# ── Fund-transfer services only (leave unset for a normal priced service) ────
# Set ONLY if your service is registered with require_fund_transfer=true.
# CROO_PROVIDER_FUND_ADDRESS=0xYourProviderReceiveAddress

# ── Requester example only (src/requester.ts — Aura hiring another agent) ─────
# The Service ID you want to hire. Not needed to run the provider.
# CROO_TARGET_SERVICE_ID=svc_REPLACE_ME
