# Copy to .env.local for local dev. On Render, set these as the static site's
# environment variables (they are read at BUILD time by Vite).

# Backend API origin — NO trailing /v1. Leave unset for local dev (defaults to
# http://localhost:3002). In production point it at the deployed API, e.g.
#   VITE_API_URL=https://croo-blog-api.onrender.com
VITE_API_URL=http://localhost:3002

# Gemini key for the in-browser AI features. NOTE: this is baked into the client
# bundle at build time, so it is visible to anyone who loads the site. Use a
# key that is restricted/rotatable.
GEMINI_API_KEY=your-gemini-key-here
