# Copy to .env.local for local dev. On Render, set these as the static site's
# environment variables (they are read at BUILD time by Vite).

# Backend API origin — NO trailing /v1. Leave unset for local dev (defaults to
# http://localhost:3002). In production point it at the deployed API, e.g.
#   VITE_API_URL=https://croo-blog-api.onrender.com
VITE_API_URL=http://localhost:3002

# No Gemini key here — AI calls go through the backend (/v1/ai/*), which holds
# GEMINI_API_KEY in its own environment.

# Google OAuth client ID for the sign-in button. Public by design (it travels in
# the auth URL) — the client SECRET belongs in the backend environment, never here.
# Use a SEPARATE OAuth client for production, and list that deploy's
# <origin>/auth-callback.html under the client's "Authorized redirect URIs".
VITE_GOOGLE_CLIENT_ID=
